{
  "datasets": [
    {
      "columns": [
        {
          "description": "",
          "displayName": "Revenue",
          "expression": "SUM(price * quantity)"
        },
        {
          "description": "",
          "displayName": "Average Order Value",
          "expression": "SUM(price * quantity) / COUNT(DISTINCT order_id)"
        }
      ],
      "displayName": "Orders & Menu Analytics",
      "name": "648a021f",
      "queryLines": [
        "SELECT\n",
        "    f.order_id,\n",
        "    f.item_id,\n",
        "    f.date_key,\n",
        "    f.event_timestamp,\n",
        "    f.discount_code,\n",
        "    f.price,\n",
        "    f.quantity,\n",
        "\n",
        "    d.full_date,\n",
        "    d.year,\n",
        "    d.month,\n",
        "    d.day_name,\n",
        "    d.is_weekend,\n",
        "\n",
        "    m.item_name,\n",
        "    m.menu_category\n",
        "\n",
        "FROM dbr_dev.yanquiel_gold.fact_orders f\n",
        "\n",
        "LEFT JOIN dbr_dev.yanquiel_gold.dim_date d\n",
        "    ON f.date_key = d.date_key\n",
        "\n",
        "LEFT JOIN dbr_dev.yanquiel_gold.dim_menu_item m\n",
        "    ON f.item_id = m.menu_item_id;"
      ]
    }
  ],
